string(LENGTH "hello world" len)
string(SUBSTRING "hello world" 0 5 sub)
string(FIND "hello world" "world" pos)
string(FIND "hello world" "missing" pos2)
string(REPLACE "world" "cmake" result "hello world")
string(REGEX MATCH "[0-9]+" match "version 3.28.1")
string(REGEX MATCHALL "[0-9]+" matches "v3.28.1-rc2")
string(REGEX REPLACE "([0-9]+)\\.([0-9]+)" "\\1_\\2" replaced "3.28")
string(TOUPPER "hello" upper)
string(TOLOWER "HELLO" lower)
string(STRIP "  hello  " stripped)
string(APPEND result " appended")
string(PREPEND result "prepended ")
string(CONCAT full "a" "b" "c" "d")
string(JOIN "," joined "a" "b" "c")
string(REPEAT "ab" 5 repeated)
string(COMPARE LESS "abc" "def" cmp)
string(COMPARE EQUAL "abc" "abc" eq)
string(ASCII 72 101 108 108 111 ascii_str)
string(HEX "hello" hex_str)
string(CONFIGURE "prefix_@upper@_suffix" configured @ONLY)
string(MAKE_C_IDENTIFIER "hello-world.foo" c_id)
string(RANDOM LENGTH 16 random_str)
string(RANDOM LENGTH 8 ALPHABET "0123456789" random_num)
string(TIMESTAMP now "%Y-%m-%d %H:%M:%S")
string(UUID uuid NAMESPACE "6ba7b810-9dad-11d1-80b4-00c04fd430c8" NAME "test" TYPE SHA1)
message(STATUS "len=${len} sub=${sub} pos=${pos} result=${result}")
