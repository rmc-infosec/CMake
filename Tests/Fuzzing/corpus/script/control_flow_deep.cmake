function(fibonacci n result_var)
  if(n LESS_EQUAL 1)
    set(${result_var} ${n} PARENT_SCOPE)
    return()
  endif()
  math(EXPR n1 "${n} - 1")
  math(EXPR n2 "${n} - 2")
  fibonacci(${n1} r1)
  fibonacci(${n2} r2)
  math(EXPR r "${r1} + ${r2}")
  set(${result_var} ${r} PARENT_SCOPE)
endfunction()
fibonacci(10 fib10)
message(STATUS "fib(10) = ${fib10}")

macro(assert_equal a b)
  if(NOT "${a}" STREQUAL "${b}")
    message(SEND_ERROR "Assertion failed: '${a}' != '${b}'")
  endif()
endmacro()

set(counter 0)
while(counter LESS 10)
  math(EXPR counter "${counter} + 1")
  if(counter EQUAL 5)
    continue()
  endif()
  list(APPEND values ${counter})
endwhile()

foreach(val RANGE 0 20 3)
  list(APPEND range_vals ${val})
endforeach()

set(items "alpha;beta;gamma;delta")
foreach(item IN LISTS items)
  string(TOUPPER "${item}" upper_item)
  list(APPEND upper_items ${upper_item})
endforeach()

foreach(idx a IN ZIP_LISTS values upper_items)
  message(STATUS "${idx}: ${a}")
endforeach()

block(SCOPE_FOR VARIABLES)
  set(inner_var "inside block")
  message(STATUS "inner: ${inner_var}")
endblock()
