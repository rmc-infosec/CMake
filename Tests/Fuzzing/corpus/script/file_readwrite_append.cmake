set(tf "${CMAKE_CURRENT_LIST_DIR}/_fuzz_rw.txt")
file(WRITE ${tf} "initial content\n")
file(APPEND ${tf} "appended line 1\n")
file(APPEND ${tf} "appended line 2\n")
file(READ ${tf} content)
message(STATUS "content: ${content}")
string(LENGTH "${content}" len)
message(STATUS "length: ${len}")
file(WRITE ${tf} "overwritten\n")
file(READ ${tf} content)
file(WRITE ${tf} "")
file(READ ${tf} content OFFSET 0)
file(WRITE ${tf} "binary\x00data\x01here\n")
file(READ ${tf} content HEX)
message(STATUS "hex: ${content}")
file(REMOVE ${tf})
