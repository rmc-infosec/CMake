# File/path tests
file(WRITE "/tmp/cmake_fuzz_if_test.txt" "test")
if(EXISTS "/tmp/cmake_fuzz_if_test.txt")
  message(STATUS "File exists")
endif()
file(REMOVE "/tmp/cmake_fuzz_if_test.txt")

file(MAKE_DIRECTORY "/tmp/cmake_fuzz_if_dir")
if(IS_DIRECTORY "/tmp/cmake_fuzz_if_dir")
  message(STATUS "Is directory")
endif()
if(NOT IS_SYMLINK "/tmp/cmake_fuzz_if_dir")
  message(STATUS "Not symlink")
endif()
if(IS_ABSOLUTE "/tmp/cmake_fuzz_if_dir")
  message(STATUS "Is absolute")
endif()
file(REMOVE_RECURSE "/tmp/cmake_fuzz_if_dir")

# Command tests
if(COMMAND message)
  message(STATUS "message command exists")
endif()
if(NOT COMMAND nonexistent_command)
  message(STATUS "nonexistent_command does not exist")
endif()

# DEFINED tests
set(MY_DEFINED_VAR "value")
if(DEFINED MY_DEFINED_VAR)
  message(STATUS "Defined")
endif()
if(NOT DEFINED UNDEFINED_VAR)
  message(STATUS "Not defined")
endif()
if(DEFINED ENV{PATH})
  message(STATUS "PATH env defined")
endif()

# IN_LIST
set(mylist "a" "b" "c" "d")
if("c" IN_LIST mylist)
  message(STATUS "c in list")
endif()
if(NOT "z" IN_LIST mylist)
  message(STATUS "z not in list")
endif()

# MATCHES
set(version "3.28.1")
if(version MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
  message(STATUS "Valid version")
endif()
if(version MATCHES "([0-9]+)\\.([0-9]+)")
  message(STATUS "Major: ${CMAKE_MATCH_1} Minor: ${CMAKE_MATCH_2}")
endif()

# VERSION comparisons
if("3.28.1" VERSION_GREATER "3.27.0")
  message(STATUS "3.28.1 > 3.27.0")
endif()
if("3.28.1" VERSION_LESS "4.0.0")
  message(STATUS "3.28.1 < 4.0.0")
endif()
if("3.28.1" VERSION_EQUAL "3.28.1")
  message(STATUS "Equal")
endif()
if("3.28.1" VERSION_GREATER_EQUAL "3.28.0")
  message(STATUS "3.28.1 >= 3.28.0")
endif()
if("3.28.1" VERSION_LESS_EQUAL "3.28.1")
  message(STATUS "3.28.1 <= 3.28.1")
endif()

# Boolean logic
set(A TRUE)
set(B FALSE)
if(A AND NOT B)
  message(STATUS "A AND NOT B")
endif()
if(A OR B)
  message(STATUS "A OR B")
endif()
if((A AND NOT B) OR (NOT A AND B))
  message(STATUS "XOR")
endif()
