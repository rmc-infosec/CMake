set(td "${CMAKE_CURRENT_LIST_DIR}/_fuzz_fs")
file(MAKE_DIRECTORY "${td}/sub1/sub2")
file(WRITE "${td}/test.txt" "content")
file(TOUCH "${td}/touched.txt")
file(TOUCH_NOCREATE "${td}/nonexistent.txt")
if(EXISTS "${td}/test.txt")
  message(STATUS "exists")
endif()
file(REAL_PATH "${td}/test.txt" rp)
get_filename_component(dir "${td}/test.txt" DIRECTORY)
get_filename_component(name "${td}/test.txt" NAME)
get_filename_component(name_we "${td}/test.txt" NAME_WE)
get_filename_component(ext "${td}/test.txt" EXT)
get_filename_component(last_ext "${td}/test.txt" LAST_EXT)
get_filename_component(abs "${td}/test.txt" ABSOLUTE)
get_filename_component(real "${td}/test.txt" REALPATH)
file(RELATIVE_PATH relpath "${td}" "${td}/sub1/sub2")
file(TO_CMAKE_PATH "/usr/local/bin" cmake_path)
file(TO_NATIVE_PATH "/usr/local/bin" native_path)
file(CREATE_LINK "${td}/test.txt" "${td}/link.txt" SYMBOLIC)
file(CREATE_LINK "${td}/test.txt" "${td}/hardlink.txt" COPY_ON_ERROR)
file(CHMOD "${td}/test.txt" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ)
file(CHMOD_RECURSE "${td}/sub1" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
file(REMOVE_RECURSE "${td}")
