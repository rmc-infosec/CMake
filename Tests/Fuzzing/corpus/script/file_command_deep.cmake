set(test_dir "${CMAKE_CURRENT_LIST_DIR}/_fuzz_tmp")
file(MAKE_DIRECTORY "${test_dir}")
file(WRITE "${test_dir}/test.txt" "hello world\nline two\nline three\n")
file(APPEND "${test_dir}/test.txt" "appended\n")
file(READ "${test_dir}/test.txt" content)
message(STATUS "content: ${content}")
file(STRINGS "${test_dir}/test.txt" lines)
message(STATUS "lines: ${lines}")
file(MD5 "${test_dir}/test.txt" hash)
message(STATUS "md5: ${hash}")
file(SHA256 "${test_dir}/test.txt" hash256)
file(SIZE "${test_dir}/test.txt" fsize)
file(TIMESTAMP "${test_dir}/test.txt" ftime)
file(GLOB globbed "${test_dir}/*.txt")
file(GLOB_RECURSE globbed_r "${test_dir}/*")
file(RENAME "${test_dir}/test.txt" "${test_dir}/renamed.txt")
file(COPY "${test_dir}/renamed.txt" DESTINATION "${test_dir}/sub")
file(RELATIVE_PATH relpath "${test_dir}" "${test_dir}/sub/renamed.txt")
file(TO_CMAKE_PATH "/usr/local/bin" cmake_path)
file(TO_NATIVE_PATH "/usr/local/bin" native_path)
file(REMOVE "${test_dir}/renamed.txt")
file(REMOVE_RECURSE "${test_dir}")
