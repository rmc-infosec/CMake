# Long elseif chains for parser coverage
set(lang "Python")

if(lang STREQUAL "C")
  message(STATUS "C language")
elseif(lang STREQUAL "C++")
  message(STATUS "C++ language")
elseif(lang STREQUAL "Java")
  message(STATUS "Java language")
elseif(lang STREQUAL "Python")
  message(STATUS "Python language")
elseif(lang STREQUAL "Rust")
  message(STATUS "Rust language")
elseif(lang STREQUAL "Go")
  message(STATUS "Go language")
elseif(lang STREQUAL "JavaScript")
  message(STATUS "JavaScript language")
else()
  message(STATUS "Unknown language: ${lang}")
endif()

# Nested if/elseif
set(os "Linux")
set(arch "x86_64")

if(os STREQUAL "Linux")
  if(arch STREQUAL "x86_64")
    message(STATUS "Linux AMD64")
  elseif(arch STREQUAL "aarch64")
    message(STATUS "Linux ARM64")
  else()
    message(STATUS "Linux ${arch}")
  endif()
elseif(os STREQUAL "Windows")
  if(arch STREQUAL "x86_64")
    message(STATUS "Windows AMD64")
  else()
    message(STATUS "Windows ${arch}")
  endif()
else()
  message(STATUS "${os} ${arch}")
endif()
