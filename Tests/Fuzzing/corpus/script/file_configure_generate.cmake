set(tf "${CMAKE_CURRENT_LIST_DIR}/_fuzz_tmp")
set(VERSION_MAJOR 3)
set(VERSION_MINOR 14)
set(ENABLE_FEATURE ON)
file(WRITE "${tf}_in.txt" "#cmakedefine ENABLE_FEATURE\n#define VER @VERSION_MAJOR@.@VERSION_MINOR@\n${DOLLAR}{computed}\n")
string(CONFIGURE "#define VER @VERSION_MAJOR@.@VERSION_MINOR@" result @ONLY)
message(STATUS "configured: ${result}")
file(WRITE "${tf}_template.in" "name=@PROJECT_NAME@\nversion=@VERSION@\n")
set(PROJECT_NAME "FuzzTest")
set(VERSION "1.0")
configure_file("${tf}_template.in" "${tf}_out.txt" @ONLY)
configure_file("${tf}_template.in" "${tf}_out2.txt" NEWLINE_STYLE UNIX)
configure_file("${tf}_template.in" "${tf}_out3.txt" NEWLINE_STYLE WIN32)
file(REMOVE "${tf}_in.txt" "${tf}_template.in" "${tf}_out.txt" "${tf}_out2.txt" "${tf}_out3.txt")
