# Complex conditional patterns
set(A 1)
set(B 2)
set(C 3)
set(NAME "hello")
set(LIST_VAR "a;b;c;d")

# Numeric comparisons
if(A LESS B AND B LESS C)
  message(STATUS "A < B < C")
endif()

if(NOT (A GREATER B OR C LESS B))
  message(STATUS "Complex NOT")
endif()

if((A EQUAL 1 AND B EQUAL 2) OR C EQUAL 0)
  message(STATUS "Grouped OR")
endif()

# String comparisons
if(NAME STREQUAL "hello")
  message(STATUS "String equal")
endif()
if(NAME STRLESS "world")
  message(STATUS "String less")
endif()
if(NAME STRGREATER "abc")
  message(STATUS "String greater")
endif()
if(NAME STRLESS_EQUAL "hello")
  message(STATUS "String less equal")
endif()
if(NAME STRGREATER_EQUAL "hello")
  message(STATUS "String greater equal")
endif()

# Type checks
set(num_str "42")
if(num_str MATCHES "^[0-9]+$")
  message(STATUS "Is numeric")
endif()

set(bool_true "TRUE")
set(bool_on "ON")
set(bool_yes "YES")
set(bool_1 "1")
foreach(v IN ITEMS bool_true bool_on bool_yes bool_1)
  if(${v})
    message(STATUS "${v} is truthy")
  endif()
endforeach()

set(bool_false "FALSE")
set(bool_off "OFF")
set(bool_no "NO")
set(bool_0 "0")
set(bool_notfound "NOTFOUND")
set(bool_xnf "X-NOTFOUND")
set(bool_ignore "IGNORE")
set(bool_empty "")
foreach(v IN ITEMS bool_false bool_off bool_no bool_0 bool_notfound bool_xnf bool_ignore bool_empty)
  if(NOT ${v})
    message(STATUS "${v} is falsy")
  endif()
endforeach()
