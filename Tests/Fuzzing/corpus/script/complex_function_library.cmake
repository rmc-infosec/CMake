# Simulate a real-world CMake utility library
function(join_strings output_var separator)
  set(result "")
  set(first TRUE)
  foreach(arg ${ARGN})
    if(first)
      set(result "${arg}")
      set(first FALSE)
    else()
      set(result "${result}${separator}${arg}")
    endif()
  endforeach()
  set(${output_var} "${result}" PARENT_SCOPE)
endfunction()

function(to_hex_list output_var)
  set(result "")
  foreach(num ${ARGN})
    math(EXPR hex "${num}" OUTPUT_FORMAT HEXADECIMAL)
    list(APPEND result "${hex}")
  endforeach()
  set(${output_var} "${result}" PARENT_SCOPE)
endfunction()

function(parse_version version_string prefix)
  string(REGEX MATCH "([0-9]+)\\.([0-9]+)\\.?([0-9]*)" _match "${version_string}")
  set(${prefix}_MAJOR "${CMAKE_MATCH_1}" PARENT_SCOPE)
  set(${prefix}_MINOR "${CMAKE_MATCH_2}" PARENT_SCOPE)
  if(CMAKE_MATCH_3)
    set(${prefix}_PATCH "${CMAKE_MATCH_3}" PARENT_SCOPE)
  else()
    set(${prefix}_PATCH "0" PARENT_SCOPE)
  endif()
endfunction()

function(list_to_string output_var input_list)
  string(REPLACE ";" " " result "${input_list}")
  set(${output_var} "${result}" PARENT_SCOPE)
endfunction()

join_strings(joined ", " "apple" "banana" "cherry")
message(STATUS "Joined: ${joined}")

to_hex_list(hexes 10 255 4096 65535)
message(STATUS "Hexes: ${hexes}")

parse_version("3.28.1" VER)
message(STATUS "Parsed: ${VER_MAJOR}.${VER_MINOR}.${VER_PATCH}")

set(mylist "a;b;c;d")
list_to_string(spaced "${mylist}")
message(STATUS "Spaced: ${spaced}")
