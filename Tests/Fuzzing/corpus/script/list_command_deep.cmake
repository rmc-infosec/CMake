set(mylist a b c d e f g)
list(LENGTH mylist len)
list(GET mylist 0 2 -1 items)
list(FIND mylist "c" idx)
list(APPEND mylist h i j)
list(INSERT mylist 3 x y)
list(REMOVE_ITEM mylist "b" "d")
list(REMOVE_AT mylist 0)
list(REMOVE_DUPLICATES mylist)
list(SORT mylist)
list(REVERSE mylist)
list(SUBLIST mylist 1 3 sub)
list(JOIN mylist "," joined)
list(PREPEND mylist first)
list(POP_BACK mylist last)
list(POP_FRONT mylist first_item)
list(FILTER mylist INCLUDE REGEX "[a-e]")
set(nums 3 1 4 1 5 9 2 6)
list(SORT nums COMPARE NATURAL)
list(REMOVE_DUPLICATES nums)
set(mixed "Apple" "banana" "Cherry" "date")
list(SORT mixed COMPARE STRING CASE INSENSITIVE)
list(TRANSFORM mixed TOUPPER OUTPUT_VARIABLE upper_list)
list(TRANSFORM mixed TOLOWER OUTPUT_VARIABLE lower_list)
list(TRANSFORM mixed STRIP)
list(TRANSFORM mixed REPLACE "^(.)" "[\\1]" OUTPUT_VARIABLE bracket_list)
message(STATUS "mylist=${mylist} len=${len} joined=${joined}")
message(STATUS "nums=${nums} upper=${upper_list}")
