set(text "Hello World 123 foo_bar test@email.com /path/to/file.txt")
string(REGEX MATCH "[0-9]+" match "${text}")
string(REGEX MATCHALL "[a-z_]+" matches "${text}")
string(REGEX REPLACE "([0-9]+)" "NUM(\\1)" result "${text}")
string(REGEX REPLACE "[[:alpha:]]+" "WORD" result "${text}")
string(REGEX MATCH "([^@]+)@([^.]+)\\.(.+)" full "${text}")
message(STATUS "match0=${CMAKE_MATCH_0} match1=${CMAKE_MATCH_1} match2=${CMAKE_MATCH_2}")
string(COMPARE LESS "abc" "def" result)
string(COMPARE GREATER "xyz" "abc" result)
string(COMPARE EQUAL "test" "test" result)
string(COMPARE NOTEQUAL "a" "b" result)
string(COMPARE LESS_EQUAL "abc" "abc" result)
string(COMPARE GREATER_EQUAL "xyz" "abc" result)
string(ASCII 72 101 108 108 111 ascii_str)
string(HEX "Hello" hex_str)
string(CONFIGURE "ver=@CMAKE_VERSION@" configured @ONLY)
string(MAKE_C_IDENTIFIER "hello-world.test" c_id)
string(RANDOM LENGTH 20 result)
string(RANDOM LENGTH 10 ALPHABET "abcdef0123456789" result)
string(UUID uuid NAMESPACE 6ba7b810-9dad-11d1-80b4-00c04fd430c8 NAME "test" TYPE SHA1)
string(REPEAT "abc" 5 result)
string(JOIN ";" joined a b c d e)
string(JOIN "/" joined "usr" "local" "bin")
