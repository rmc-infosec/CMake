set(td "${CMAKE_CURRENT_LIST_DIR}/_fuzz_copy")
file(MAKE_DIRECTORY "${td}/src" "${td}/dst" "${td}/dst2")
file(WRITE "${td}/src/a.txt" "file a")
file(WRITE "${td}/src/b.txt" "file b")
file(WRITE "${td}/src/sub/c.txt" "file c")
file(COPY "${td}/src/a.txt" DESTINATION "${td}/dst")
file(COPY "${td}/src/" DESTINATION "${td}/dst2" FILES_MATCHING PATTERN "*.txt")
file(COPY "${td}/src/a.txt" DESTINATION "${td}/dst" FILE_PERMISSIONS OWNER_READ OWNER_WRITE)
file(INSTALL "${td}/src/b.txt" DESTINATION "${td}/dst2")
file(RENAME "${td}/dst/a.txt" "${td}/dst/renamed.txt")
file(REMOVE_RECURSE "${td}")
