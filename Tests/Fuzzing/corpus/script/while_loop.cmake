set(count 0)
while(count LESS 10)
  math(EXPR count "${count} + 1")
endwhile()
message(STATUS "Count: ${count}")

# Nested while
set(i 0)
set(total 0)
while(i LESS 5)
  set(j 0)
  while(j LESS 3)
    math(EXPR total "${total} + 1")
    math(EXPR j "${j} + 1")
  endwhile()
  math(EXPR i "${i} + 1")
endwhile()
message(STATUS "Total: ${total}")

# While with break/continue
set(n 0)
set(sum 0)
while(TRUE)
  math(EXPR n "${n} + 1")
  if(n GREATER 100)
    break()
  endif()
  math(EXPR mod "${n} % 2")
  if(mod EQUAL 0)
    continue()
  endif()
  math(EXPR sum "${sum} + ${n}")
endwhile()
message(STATUS "Sum of odd 1-100: ${sum}")
