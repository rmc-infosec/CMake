set(td "${CMAKE_CURRENT_LIST_DIR}/_fuzz_archive")
file(MAKE_DIRECTORY "${td}/input" "${td}/output")
file(WRITE "${td}/input/file1.txt" "content1")
file(WRITE "${td}/input/file2.txt" "content2")
file(ARCHIVE_CREATE OUTPUT "${td}/test.tar" PATHS "${td}/input" FORMAT gnutar)
file(ARCHIVE_CREATE OUTPUT "${td}/test.tar.gz" PATHS "${td}/input" FORMAT gnutar COMPRESSION GZip)
file(ARCHIVE_CREATE OUTPUT "${td}/test.zip" PATHS "${td}/input" FORMAT zip)
file(ARCHIVE_CREATE OUTPUT "${td}/test.7z" PATHS "${td}/input" FORMAT 7zip)
file(ARCHIVE_CREATE OUTPUT "${td}/test.tar.xz" PATHS "${td}/input" FORMAT gnutar COMPRESSION XZ)
file(ARCHIVE_CREATE OUTPUT "${td}/test.tar.zstd" PATHS "${td}/input" FORMAT gnutar COMPRESSION Zstd)
file(ARCHIVE_EXTRACT INPUT "${td}/test.tar.gz" DESTINATION "${td}/output")
file(ARCHIVE_EXTRACT INPUT "${td}/test.zip" DESTINATION "${td}/output" PATTERNS "*.txt")
file(REMOVE_RECURSE "${td}")
