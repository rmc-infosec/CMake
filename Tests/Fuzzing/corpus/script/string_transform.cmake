set(input "Hello World FooBar test_value CMAKE_CXX_FLAGS")
string(TOLOWER "${input}" lower)
string(TOUPPER "${input}" upper)
string(LENGTH "${input}" len)
string(SUBSTRING "${input}" 0 5 sub)
string(SUBSTRING "${input}" 6 -1 sub)
string(FIND "${input}" "World" pos)
string(FIND "${input}" "orld" pos REVERSE)
string(REPLACE "World" "CMake" result "${input}")
string(STRIP "  hello  " result)
string(STRIP "\t\nhello\n\t" result)
string(APPEND result " extra")
string(PREPEND result "prefix_")
string(CONCAT full "part1" "part2" "part3")
string(TIMESTAMP now "%Y-%m-%d %H:%M:%S")
string(TIMESTAMP utc "%Y-%m-%dT%H:%M:%SZ" UTC)
math(EXPR val "3 + 4 * 2")
math(EXPR val "100 / 7")
math(EXPR val "0xFF & 0x0F" OUTPUT_FORMAT HEXADECIMAL)
math(EXPR val "(1 << 8) - 1")
math(EXPR val "255 | 128")
math(EXPR val "~0 & 0xFF")
