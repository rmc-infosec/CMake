include(ProcessorCount OPTIONAL)
if(COMMAND ProcessorCount)
  ProcessorCount(N)
  message(STATUS "Processor count: ${N}")
  if(N EQUAL 0)
    set(N 1)
  endif()
  math(EXPR half_N "${N} / 2")
  message(STATUS "Half CPUs: ${half_N}")
  math(EXPR N_plus_1 "${N} + 1")
  message(STATUS "N+1: ${N_plus_1}")
else()
  message(STATUS "ProcessorCount not available")
endif()

cmake_host_system_information(RESULT logical_cores QUERY NUMBER_OF_LOGICAL_CORES)
cmake_host_system_information(RESULT physical_cores QUERY NUMBER_OF_PHYSICAL_CORES)
message(STATUS "Logical: ${logical_cores}, Physical: ${physical_cores}")
