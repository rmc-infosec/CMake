set(tf "${CMAKE_CURRENT_LIST_DIR}/_fuzz_tmp.txt")
file(WRITE ${tf} "line one\nline two abc\nshort\nline four is longer\n12345\n")
file(STRINGS ${tf} lines)
file(STRINGS ${tf} lines LENGTH_MINIMUM 5)
file(STRINGS ${tf} lines LENGTH_MAXIMUM 8)
file(STRINGS ${tf} lines REGEX "^line")
file(STRINGS ${tf} lines LIMIT_COUNT 2)
file(STRINGS ${tf} lines LIMIT_INPUT 15)
file(STRINGS ${tf} lines ENCODING UTF-8)
file(MD5 ${tf} h)
file(SHA1 ${tf} h)
file(SHA256 ${tf} h)
file(SHA384 ${tf} h)
file(SHA512 ${tf} h)
file(SHA3_256 ${tf} h)
file(SIZE ${tf} sz)
file(READ ${tf} content)
file(READ ${tf} content OFFSET 5 LIMIT 10)
file(REMOVE ${tf})
