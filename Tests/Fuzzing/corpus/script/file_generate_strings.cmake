set(tmpdir "${CMAKE_CURRENT_LIST_DIR}/_fuzz_tmp2")
file(MAKE_DIRECTORY "${tmpdir}")
file(WRITE "${tmpdir}/data.bin" "binary\x00data\x01here\xff")
file(READ "${tmpdir}/data.bin" bindata HEX)
message(STATUS "hex: ${bindata}")
file(READ "${tmpdir}/data.bin" limited LIMIT 6)
file(READ "${tmpdir}/data.bin" offset_data OFFSET 7)
file(WRITE "${tmpdir}/multi.txt" "line1\n" "line2\n" "line3\n")
file(STRINGS "${tmpdir}/multi.txt" all_lines)
file(STRINGS "${tmpdir}/multi.txt" long_lines LENGTH_MINIMUM 5)
file(STRINGS "${tmpdir}/multi.txt" short_lines LENGTH_MAXIMUM 4)
file(STRINGS "${tmpdir}/multi.txt" regex_lines REGEX "line[12]")
string(SHA1 "${tmpdir}/data.bin" sha1)
file(WRITE "${tmpdir}/cmake_script.cmake" "message(STATUS hello)\n")
file(REMOVE_RECURSE "${tmpdir}")
