{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "binaryDir": "${sourceDir}/build",
      "generator": "Ninja"
    }
  ],
  "buildPresets": [
    {
      "name": "build-default",
      "configurePreset": "default",
      "jobs": 4,
      "targets": ["all"],
      "cleanFirst": false,
      "verbose": true
    },
    {
      "name": "build-clean",
      "configurePreset": "default",
      "cleanFirst": true,
      "nativeToolOptions": ["-k", "0"]
    }
  ],
  "testPresets": [
    {
      "name": "test-default",
      "configurePreset": "default",
      "output": {
        "outputOnFailure": true,
        "verbosity": "verbose",
        "shortProgress": true
      },
      "execution": {
        "jobs": 8,
        "timeout": 120,
        "stopOnFailure": false,
        "repeat": {"mode": "until-pass", "count": 2}
      },
      "filter": {
        "include": {"name": "unit.*"},
        "exclude": {"label": "slow"}
      }
    }
  ]
}
