{
  "version": 6,
  "configurePresets": [
    {
      "name": "linux-only",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "not-windows",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "not",
        "condition": {
          "type": "equals",
          "lhs": "${hostSystemName}",
          "rhs": "Windows"
        }
      }
    },
    {
      "name": "complex-condition",
      "binaryDir": "${sourceDir}/build",
      "condition": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "equals",
            "lhs": "${hostSystemName}",
            "rhs": "Linux"
          },
          {
            "type": "allOf",
            "conditions": [
              {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
              },
              {
                "type": "matches",
                "string": "${generator}",
                "regex": "Ninja.*"
              }
            ]
          }
        ]
      }
    }
  ]
}
