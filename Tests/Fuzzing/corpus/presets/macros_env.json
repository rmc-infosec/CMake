{
  "version": 6,
  "configurePresets": [
    {
      "name": "with-macros",
      "binaryDir": "${sourceDir}/build-${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/toolchain.cmake",
      "environment": {
        "MY_VAR": "value",
        "PATH_EXT": "/opt/bin:$penv{PATH}",
        "INHERITED": "$env{MY_VAR}_suffix"
      },
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{MY_VAR}/prefix",
        "VAR_WITH_MACRO": "${sourceDir}/${presetName}/data",
        "DOLLAR_LITERAL": "$dollar",
        "GENERATOR_VAR": "${generator}"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      }
    }
  ]
}
